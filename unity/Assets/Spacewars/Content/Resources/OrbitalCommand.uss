.orbital-root { color: rgb(227,240,247); font-size: 16px; }
.orbital-screen { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(9,13,17); padding: 28px; align-items: center; justify-content: center; }
.orbital-art { -unity-background-scale-mode: scale-and-crop; }
.orbital-card { background-color: rgba(9,17,21,0.97); border-width: 1px; border-color: rgb(58,84,99); padding: 24px; width: 560px; max-width: 96%; max-height: 96%; }
.orbital-title { font-size: 32px; -unity-font-style: bold; color: rgb(227,240,247); margin-bottom: 20px; white-space: normal; }
.orbital-body { white-space: normal; margin-bottom: 12px; }
.orbital-muted { color: rgb(135,163,179); white-space: normal; font-size: 13px; margin-top: 8px; margin-bottom: 8px; }
.orbital-button { min-height: 40px; height: 44px; flex-shrink: 0; margin: 0 0 7px 0; padding: 6px 16px; background-color: rgba(12,28,37,0.97); border-width: 1px; border-color: rgb(58,84,99); border-radius: 2px; color: rgb(227,240,247); font-size: 17px; -unity-text-align: middle-left; white-space: normal; }
.orbital-primary { border-left-width: 4px; border-color: rgb(69,217,240); -unity-font-style: bold; }
.orbital-button:hover, .orbital-button:focus, .orbital-focused { background-color: rgb(20,49,61); border-color: rgb(69,217,240); color: white; }
.orbital-button:disabled { opacity: 1; color: rgb(116,139,152); background-color: rgb(16,25,30); border-color: rgb(47,58,64); }
.orbital-root .unity-base-field { flex-shrink: 0; min-height: 38px; margin-bottom: 12px; color: rgb(227,240,247); }
.orbital-root .unity-base-field__label { color: rgb(227,240,247); min-width: 190px; white-space: normal; }
.orbital-root .unity-base-field__input { background-color: rgb(18,32,41); color: rgb(227,240,247); border-width: 1px; border-color: rgb(58,84,99); padding: 6px; }
.orbital-root .unity-base-field:focus > .unity-base-field__input { border-color: rgb(69,217,240); }
.orbital-root .unity-toggle__checkmark { background-color: rgb(35,66,78); border-color: rgb(69,217,240); }
.orbital-root .unity-base-slider__tracker { background-color: rgb(58,84,99); }
.orbital-root .unity-base-slider__dragger { background-color: rgb(69,217,240); }
.orbital-main-stack { position: absolute; left: 53%; top: 12%; width: 40%; max-width: 560px; }
.orbital-logo { font-size: 52px; -unity-font-style: bold; letter-spacing: 2px; margin-bottom: 22px; color: white; }
.orbital-main-stack .orbital-button { height: 46px; font-size: 19px; }
.orbital-hints { color: rgb(164,190,203); font-size: 13px; white-space: normal; margin-top: 12px; }
.orbital-lab-card { width: 1120px; height: 94%; }
.orbital-toolbar { flex-direction: row; flex-wrap: wrap; }
.orbital-toolbar .orbital-button { margin-right: 8px; flex-grow: 1; }
.orbital-keyboard { position: absolute; left: 8%; right: 8%; top: 16%; bottom: 10%; background-color: rgb(9,17,21); border-width: 2px; border-color: rgb(69,217,240); padding: 20px; }
.orbital-keyboard-keys { flex-direction: row; flex-wrap: wrap; }
.orbital-keyboard-keys .orbital-button { width: 44px; margin-right: 4px; -unity-text-align: middle-center; }

.orbital-menu-footer { background-color: rgba(9,17,21,0.9); padding: 6px 12px; margin-top: 8px; border-left-width: 1px; border-left-color: rgb(58,84,99); }
.orbital-menu-footer .orbital-muted { margin-top: 5px; margin-bottom: 5px; }
.orbital-menu-footer .orbital-hints { margin-top: 5px; margin-bottom: 5px; }
/* A new scrolling container must not introduce scrollbar controls outside the lab. */
.orbital-root .unity-scroll-view .unity-scroller { visibility: hidden; }
.orbital-root .orbital-lab-card .unity-scroll-view .unity-scroller { visibility: visible; }
.orbital-root .unity-scroller__low-button, .orbital-root .unity-scroller__high-button { display: none; }
.orbital-root .unity-scroller--vertical { width: 10px; min-width: 10px; }

.orbital-lab-toolbar .orbital-button { padding-left: 10px; padding-right: 10px; font-size: 15px; }
.orbital-root .unity-scroller .unity-base-field__input { padding: 0; border-width: 0; background-color: transparent; }

.orbital-menu-footer .orbital-button { min-height: 36px; height: 36px; font-size: 14px; }

.orbital-lab-groups .orbital-button { height: auto; min-height: 44px; padding: 10px 12px; font-size: 15px; }

.orbital-settings-card { width: 1000px; height: 94%; max-height: 740px; }
#settings-body { flex-direction: row; flex-grow: 1; min-height: 0; }
#settings-tabs { width: 146px; min-width: 146px; flex-shrink: 0; margin-right: 20px; }
#settings-tabs .settings-tab { padding-left: 12px; padding-right: 12px; border-left-width: 4px; }
#settings-tabs .settings-tab-selected { border-left-color: rgb(69,217,240); background-color: rgb(20,49,61); -unity-font-style: bold; }
#settings-tabs .settings-tab:focus { border-color: white; }
#settings-scroll { flex-basis: 0; min-width: 0; }
#settings-scroll { flex-grow: 1; }
#settings-scroll { margin-bottom: 12px; }
#settings-scroll .unity-base-field__label { width: 220px; min-width: 220px; max-width: 220px; flex-grow: 0; flex-shrink: 0; margin-left: 0; margin-right: 12px; }
#settings-scroll .unity-base-field__input { margin-left: 0; margin-right: 0; }
#settings-scroll .unity-toggle > .unity-base-field__input { background-color: transparent; border-width: 0; padding: 0; }
#settings-scroll .unity-toggle__checkmark { width: 24px; height: 24px; min-width: 24px; min-height: 24px; flex-shrink: 0; border-width: 2px; border-radius: 3px; border-color: rgb(135,163,179); background-color: rgb(18,32,41); -unity-background-image-tint-color: white; }
#settings-scroll .unity-toggle:checked .unity-toggle__checkmark { background-color: rgb(24,91,108); border-color: rgb(69,217,240); }
#settings-scroll .unity-toggle:focus .unity-toggle__checkmark { border-color: white; }
#settings-scroll .settings-value { margin-left: 232px; }

/* Shared quiet signature, with reserved space on every menu page. */
.orbital-screen { padding-bottom: 58px; }
.orbital-copyright { position: absolute; left: 24px; right: 24px; bottom: 16px; color: rgb(227,240,247); background-color: rgba(4,10,15,0.9); padding: 6px 12px; border-radius: 2px; font-size: 13px; white-space: normal; -unity-text-align: middle-center; flex-shrink: 0; margin: 0; }
.orbital-loading-shade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.orbital-loading-stack { position: absolute; top: 17%; left: 0; right: 0; align-items: center; }
.orbital-loading-wordmark { flex-direction: row; justify-content: center; flex-shrink: 0; }
.orbital-loading-title { -unity-font-style: bold; color: rgb(236,246,250); margin: 0; padding: 0; white-space: nowrap; }
.orbital-loading-caption { margin-top: 16px; font-size: 11px; letter-spacing: 5px; color: rgb(165,197,208); -unity-text-align: middle-center; }
.orbital-loading-activity { position: absolute; bottom: 17%; align-items: center; }
.orbital-loading-status { color: rgb(195,214,223); font-size: 15px; margin: 0 0 22px 0; padding: 0; -unity-text-align: middle-center; white-space: normal; }
.orbital-loading-line { width: 100%; height: 2px; }
.orbital-loading .orbital-copyright { bottom: 4.5%; font-size: 11px; color: rgb(127,155,168); background-color: transparent; }


/* The settings scrollbar is isolated from label and control columns. */
.orbital-root .settings-scroll .unity-scroller { visibility: visible; }
.settings-scroll .unity-scroller--vertical { width: 10px; min-width: 10px; max-width: 10px; margin-left: 8px; margin-right: 0; }
.settings-scroll .unity-scroller--vertical .unity-slider { width: 10px; min-width: 0; max-width: 10px; margin: 0; padding: 0; }
.settings-scroll .unity-scroller--vertical .unity-base-field__input { width: 10px; min-width: 0; max-width: 10px; }
.settings-scroll .unity-scroller--vertical .unity-base-slider__dragger { width: 6px; min-width: 6px; border-radius: 3px; }

/* The lab uses the entire viewport; compact controls leave room for data. */
#laboratory-screen { padding: 0 0 28px 0; }
#laboratory-screen .orbital-lab-card { width: 100%; height: 100%; max-width: 100%; max-height: 100%; padding: 10px; border-width: 0; }
#laboratory-screen .orbital-title { font-size: 22px; margin-bottom: 4px; }
#laboratory-screen .orbital-muted { margin: 2px 0; }
#laboratory-screen .unity-base-field { min-height: 30px; margin: 0 4px 4px 0; font-size: 14px; }
#laboratory-screen .unity-base-field__label { min-width: 130px; }
#laboratory-screen .unity-base-field__input { padding: 3px 6px; }
.lab-profile-bar { flex-direction: row; }
.lab-profile-bar .unity-base-field { flex-grow: 1; flex-basis: 0; min-width: 0; }
#laboratory-screen .orbital-button { min-height: 30px; height: 32px; font-size: 14px; padding: 3px 10px; margin-bottom: 4px; }
#laboratory-screen .orbital-lab-groups .orbital-button { flex-direction: row; align-items: center; height: 34px; min-height: 34px; padding: 3px 8px; }
.lab-context { font-size: 14px; color: rgb(69,217,240); margin: 4px 0; }
.lab-subheading { font-size: 13px; -unity-font-style: bold; color: rgb(135,163,179); padding: 5px 8px; background-color: rgb(16,29,36); margin-top: 5px; }
.lab-parameter-row { flex-direction: row; align-items: center; min-height: 32px; border-bottom-width: 1px; border-bottom-color: rgb(28,43,51); }
#laboratory-screen .lab-parameter { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; margin: 0; }
#laboratory-screen .lab-parameter .unity-base-field__label { width: 68%; min-width: 0; flex-shrink: 1; margin-right: 6px; }
#laboratory-screen .lab-parameter .unity-base-field__input { min-width: 65px; }
.lab-unit { width: 52px; color: rgb(135,163,179); font-size: 12px; padding-left: 6px; }
#laboratory-screen .lab-adjust { width: 26px; height: 26px; min-height: 26px; padding: 0; margin: 0 0 0 3px; -unity-text-align: middle-center; }
.lab-info { width: 22px; color: rgb(69,217,240); -unity-text-align: middle-center; font-size: 12px; }
.lab-help { min-height: 44px; max-height: 62px; white-space: normal; font-size: 13px; color: rgb(164,190,203); margin-top: 5px; padding: 5px 8px; background-color: rgb(16,29,36); }
#laboratory-screen .orbital-hints { margin-top: 4px; }
#laboratory-screen .orbital-copyright { bottom: 7px; }

#audio-laboratory-screen { padding: 0 0 28px 0; }
#audio-laboratory-screen .orbital-lab-card { width: 100%; height: 100%; max-width: 100%; max-height: 100%; padding: 10px; border-width: 0; }
#audio-laboratory-screen .orbital-title { font-size: 22px; margin-bottom: 4px; }
#audio-laboratory-screen .unity-base-field { min-height: 30px; margin-bottom: 0; font-size: 14px; }
#audio-laboratory-screen .unity-base-field__label { width: 280px; }
#audio-laboratory-screen .orbital-button { height: 32px; min-height: 32px; font-size: 14px; }
#audio-laboratory-screen .orbital-copyright { bottom: 7px; }

.lab-tree-children { margin-left: 12px; padding-left: 5px; border-left-width: 1px; border-left-color: rgb(58,84,99); margin-bottom: 5px; }
#laboratory-screen .orbital-lab-groups .lab-tree-section { height: auto; min-height: 34px; -unity-font-style: bold; }
.lab-before { width: 94px; font-size: 12px; color: rgb(135,163,179); padding-left: 6px; }
.lab-name-change { white-space: normal; padding: 6px; font-size: 14px; color: rgb(69,217,240); }

/* Scrollbar controls must not inherit the compact editor input padding. */
#laboratory-screen .unity-scroller--vertical { width: 10px; min-width: 10px; max-width: 10px; margin-left: 2px; margin-right: 0; }
#laboratory-screen .unity-scroller .unity-base-field { width: 10px; min-width: 0; max-width: 10px; margin: 0; }
#laboratory-screen .unity-scroller .unity-base-field__input { width: 10px; min-width: 0; max-width: 10px; padding: 0; border-width: 0; background-color: transparent; }

/* Ordered profile/revision actions with space between controls and rows. */
.lab-controls { flex-direction: column; flex-wrap: wrap; align-items: flex-start; margin-top: 8px; margin-bottom: 6px; }
.lab-profile-controls { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; margin-right: 12px; margin-bottom: 6px; }
.lab-revision-controls { flex-direction: row; flex-wrap: wrap; align-items: center; flex-grow: 1; min-width: 0; }
#laboratory-screen .lab-controls .orbital-button { flex-grow: 0; margin: 0 8px 6px 0; }
#laboratory-screen .lab-controls .unity-base-field { margin: 0 8px 6px 0; }
#laboratory-screen .lab-controls .unity-base-field__label { width: 76px; min-width: 76px; margin-right: 6px; white-space: nowrap; }
#lab-name { width: 225px; }
#lab-revisions { width: 185px; }
#lab-search { margin-left: 0; margin-right: 8px; margin-top: 4px; margin-bottom: 10px; }
#lab-search .unity-base-field__label { width: 76px; min-width: 76px; margin-right: 6px; }
#laboratory-screen .orbital-lab-groups .orbital-button.lab-dirty { color: rgb(255,197,104); }

#laboratory-screen .orbital-lab-groups .lab-dirty .unity-label { color: rgb(255,197,104); }

.high-contrast Label { color: white; }
.high-contrast Button { color: white; background-color: rgb(8,18,25); border-color: white; }
.high-contrast .orbital-card { background-color: rgb(4,10,14); }

#lab-profiles { width: 330px; }
#lab-revisions { width: 330px; }
#lab-confirm .orbital-card { width: 740px; }
#lab-confirm-diff { max-height: 360px; }
#lab-focus-help { flex-shrink: 0; }

.lab-inline-help { white-space: normal; font-size: 13px; color: rgb(164,190,203); background-color: rgb(16,29,36); padding: 6px 8px; margin: 4px 0; border-left-width: 2px; border-left-color: rgb(69,217,240); }

#laboratory-screen .lab-release-selected { border-color: rgb(45, 211, 235); background-color: rgb(18, 57, 68); }

#lab-profiles > .unity-base-field__label, #lab-revisions > .unity-base-field__label, #lab-search > .unity-base-field__label { width: 76px; min-width: 76px; max-width: 76px; flex-shrink: 0; margin-left: 0; margin-right: 6px; padding-left: 0; padding-right: 0; }
#lab-profiles > .unity-base-field__input, #lab-revisions > .unity-base-field__input, #lab-search > .unity-base-field__input { margin-left: 0; margin-right: 0; }

/* Selected-building Soft Dock: one surface, quiet circular queue wells. */
.soft-building-dock {
    background-color: rgba(13, 23, 29, 0.94);
    border-width: 1px; border-color: rgba(150, 189, 205, 0.30);
    border-radius: 32px;
}
.soft-building-dock #production-slots, .soft-building-dock #research-slots { align-items: center; min-width: 0; }
.soft-building-dock .dock-order:hover { background-color: rgba(73, 133, 155, 0.20); border-color: rgba(150, 218, 230, 0.70); }
.soft-building-dock .dock-order:focus { border-width: 2px; border-color: rgb(110, 224, 240); }
.soft-building-dock .dock-order:disabled { opacity: 0.65; }
.soft-building-dock .dock-spare:disabled { opacity: 0.28; }
.high-contrast .soft-building-dock { background-color: rgb(4, 10, 14); border-color: white; }
