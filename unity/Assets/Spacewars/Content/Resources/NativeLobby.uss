/* GenericDropdownMenu uses the panel root, outside the UIDocument subtree. */
.unity-base-dropdown__container-outer,
.unity-base-dropdown__container-inner {
    background-color: #0d1112;
    color: #e5eef1;
    border-color: #53636a;
    border-width: 1px;
}
.unity-base-dropdown__item {
    background-color: #0d1112;
    color: #e5eef1;
    min-height: 32px;
}
.unity-base-dropdown__label { color: #e5eef1; white-space: normal; flex-shrink: 1; min-width: 0; }
/* Constrain content to the popup viewport instead of measuring a wider single line. */
.unity-base-dropdown__container-inner .unity-scroll-view__content-container { width: 100%; min-width: 0; }
.unity-base-dropdown__item { flex-shrink: 0; }
/* GenericDropdownMenu owns its ScrollView internally. Collapse both axes before layout. */
.unity-base-dropdown .unity-scroller { visibility: hidden; }
.unity-base-dropdown .unity-scroller--horizontal { height: 0; min-height: 0; }
.unity-base-dropdown .unity-scroller--vertical { width: 0; min-width: 0; }
#lobby-map-choice .unity-base-popup-field__text { white-space: normal; min-width: 0; }

.unity-base-dropdown__item:hover,
.unity-base-dropdown__item:focus {
    background-color: #15343b;
    color: #70d9e8;
}
.unity-base-dropdown__item:hover .unity-base-dropdown__label,
.unity-base-dropdown__item:focus .unity-base-dropdown__label { color: #70d9e8; }
.unity-base-dropdown__checkmark { -unity-background-image-tint-color: #70d9e8; }
.premium-participant {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    min-height: 68px;
    margin-top: 7px;
    padding: 8px;
    background-color: rgba(19, 38, 50, 0.75);
    border-width: 1px;
    border-color: #344d5a;
    border-left-width: 3px;
}
.premium-participant .unity-base-field { margin-right: 10px; margin-bottom: 0; }
.premium-participant .unity-base-field__input {
    min-height: 36px;
    background-color: #132934;
    color: #e4eff5;
    border-width: 1px;
    border-color: #426170;
    padding: 6px;
    font-size: 16px;
}
.premium-participant .unity-base-field__input:focus,
.premium-participant .unity-base-field:focus { border-color: #58d5dd; }
#premium-lobby .unity-button { flex-direction: row; align-items: center; justify-content: center; }
#premium-lobby .unity-button:focus { border-color: #58d5dd; background-color: #153c49; }
